---
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="footer-title">gh-breakout</div>
        <p class="footer-tagline">
          Predicting breakout GitHub repositories before they trend using machine learning and the public GH Archive stream.
        </p>
        <div class="footer-badges">
          <span class="badge badge-neutral">100% Free & Open Source</span>
          <span class="badge badge-neutral">Zero Paid Services</span>
          <span class="badge badge-success">Tamper-Evident Ledger</span>
        </div>
      </div>

      <div class="footer-links-grid">
        <div class="links-col">
          <div class="col-title">Navigation</div>
          <ul>
            <li><a href={`${base}/`}>Leaderboard</a></li>
            <li><a href={`${base}/track-record/`}>Track Record</a></li>
            <li><a href={`${base}/backtest/`}>Time Machine</a></li>
            <li><a href={`${base}/explore/`}>SQL Explorer</a></li>
          </ul>
        </div>
        <div class="links-col">
          <div class="col-title">Transparency</div>
          <ul>
            <li><a href={`${base}/methodology/`}>Methodology & Model</a></li>
            <li><a href={`${base}/status/`}>Pipeline Observability</a></li>
            <li><a href={`${base}/about/`}>About & Data Sources</a></li>
            <li><a href="https://github.com/Yash-814800/GH-Breakout/blob/main/ledger/predictions.csv" target="_blank" rel="noopener noreferrer">Ledger CSV</a></li>
          </ul>
        </div>
        <div class="links-col">
          <div class="col-title">Community</div>
          <ul>
            <li><a href="https://github.com/Yash-814800/GH-Breakout" target="_blank" rel="noopener noreferrer">GitHub Repository</a></li>
            <li><a href="https://huggingface.co/datasets/Yasshh814/gh-breakout-events" target="_blank" rel="noopener noreferrer">Hugging Face Lake</a></li>
            <li><a href="https://github.com/Yash-814800/GH-Breakout/issues/new?title=Opt-out+request" target="_blank" rel="noopener noreferrer">Opt-out Request</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="disclaimer">
        Not affiliated with, endorsed by, or sponsored by GitHub, Inc. or Microsoft. Data derived from public GH Archive events and GitHub REST/GraphQL APIs under fair use.
      </div>
      <div class="copyright">
        © {currentYear} gh-breakout · Built with Astro, DuckDB & Observable Plot
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-card);
    border-top: 1px solid var(--border-color);
    padding: 3rem 0 2rem;
    font-size: 0.875rem;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .footer-brand {
    max-width: 380px;
  }

  .footer-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer-links-grid {
    display: flex;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .links-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .col-title {
    font-weight: 600;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .links-col a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .links-col a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .footer-bottom {
    border-top: 1px solid var(--border-color);
    padding-top: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .disclaimer {
    max-width: 600px;
  }
</style>
