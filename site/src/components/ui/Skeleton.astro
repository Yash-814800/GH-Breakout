---
interface Props {
  width?: string;
  height?: string;
  class?: string;
}
const { width = '100%', height = '16px', class: cls } = Astro.props;
---

<span class:list={['skel', cls]} style={`--w:${width};--h:${height}`} aria-hidden="true"></span>

<style>
  .skel {
    display: block;
    width: var(--w);
    height: var(--h);
    border-radius: var(--r-sm);
    background: linear-gradient(90deg, var(--surface) 0%, var(--line) 50%, var(--surface) 100%);
    background-size: 200% 100%;
    animation: skel 1.4s linear infinite;
  }
  @keyframes skel {
    to {
      background-position: -200% 0;
    }
  }
</style>
