---
import nodes from 'lucide-static/icon-nodes.json';

interface Props {
  name: string;
  size?: number;
  stroke?: number;
  /** Accessible name; omit for decorative icons. */
  label?: string;
  class?: string;
  fill?: boolean;
}
const { name, size = 16, stroke = 1.75, label, class: cls, fill = false } = Astro.props;

// Lucide dropped brand icons, so the GitHub mark is drawn here (24 px grid, filled).
const GITHUB =
  'M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z';

const node = (nodes as Record<string, [string, Record<string, string>][]>)[name];
if (name !== 'github' && !node) throw new Error(`Icon: unknown Lucide icon "${name}"`);
---

{
  name === 'github' ? (
    <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false">
      <path d={GITHUB} />
    </svg>
  ) : (
    <svg
      class={cls}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill={fill ? 'currentColor' : 'none'}
      stroke="currentColor"
      stroke-width={stroke}
      stroke-linecap="round"
      stroke-linejoin="round"
      role={label ? 'img' : undefined}
      aria-label={label}
      aria-hidden={label ? undefined : 'true'}
      focusable="false"
    >
      {node.map(([tag, attrs]) => {
        const Tag = tag as 'path';
        return <Tag {...attrs} />;
      })}
    </svg>
  )
}
