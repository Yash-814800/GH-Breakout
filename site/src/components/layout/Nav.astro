---
import { BRAND, NAV } from '../../lib/site';
import { url, GITHUB_REPO } from '../../lib/url';
import Logo from './Logo.astro';
import FreshnessPill from './FreshnessPill.astro';
import ThemeToggle from './ThemeToggle.astro';
import MobileMenu from './MobileMenu.astro';
import Button from '../ui/Button.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => {
  const full = url(href);
  return href === '/' ? path === full || path.startsWith(url('/repo/')) : path.startsWith(full);
};
---

<header class="nav">
  <div class="nav-in">
    <a class="brand" href={url('/')} aria-label={`${BRAND}, home`}>
      <Logo />
      <span class="wordmark">{BRAND}</span>
    </a>
    <nav class="links" aria-label="Main">
      {NAV.map((l) => <a href={url(l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <div class="tools">
      <span class="fresh-wrap"><FreshnessPill /></span>
      <ThemeToggle />
      <Button variant="icon" icon="github" href={GITHUB_REPO} label="Source code on GitHub" external />
      <button type="button" class="btn btn-ghost btn-md menu-btn" data-menu-open aria-haspopup="dialog">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        Menu
      </button>
    </div>
  </div>
</header>
<MobileMenu />

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    height: var(--nav-h);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  @supports (backdrop-filter: blur(1px)) {
    .nav {
      background: color-mix(in srgb, var(--bg) 78%, transparent);
      backdrop-filter: saturate(180%) blur(16px);
      -webkit-backdrop-filter: saturate(180%) blur(16px);
    }
  }
  .nav-in {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 100%;
    max-width: calc(var(--container) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: none;
    min-height: 40px;
  }
  .wordmark {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .links {
    display: none;
    align-items: center;
    gap: 2px;
    min-width: 0;
  }
  .links a {
    position: relative;
    padding: 8px 12px;
    border-radius: var(--r-md);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-2);
    white-space: nowrap;
    transition: color var(--dur-1) var(--ease);
  }
  .links a:hover {
    color: var(--ink);
  }
  .links a[aria-current='page'] {
    color: var(--ink);
  }
  .links a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: -9px;
    height: 2px;
    background: var(--accent);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }
  .fresh-wrap {
    display: none;
    margin-right: 8px;
  }
  @media (min-width: 1024px) {
    .links {
      display: flex;
    }
    .fresh-wrap {
      display: block;
    }
    .menu-btn {
      display: none;
    }
  }
  @media (min-width: 1024px) and (max-width: 1179px) {
    .fresh-wrap {
      display: none;
    }
  }
</style>
