---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

let insights = {
  title: 'Data Insights & History Stories',
  description: 'Deep-dive historical analysis across 10 years of GitHub Archive events, candidates, and breakouts.',
  generated_at: new Date().toISOString(),
  stories: [],
};

const insightsPath = path.resolve('public/data/insights.json');
if (fs.existsSync(insightsPath)) {
  try {
    insights = JSON.parse(fs.readFileSync(insightsPath, 'utf-8'));
  } catch (e) {
    console.error('Error reading insights.json', e);
  }
}

const stories = insights.stories || [];
---

<Layout title="Data Insights · gh-breakout">
  <div class="container">
    <div class="page-header">
      <div class="header-titles">
        <h1>Historical Data Insights</h1>
        <p class="subtitle">
          Empirical data stories extracted from 10 years of GH Archive event history, candidate trajectories, and breakout outcomes.
        </p>
      </div>
      <div class="header-meta">
        <span class="badge badge-accent">4 History Stories</span>
        <span class="badge badge-neutral">Full-History Analytics</span>
      </div>
    </div>

    <div class="caption-banner">
      <div class="caption-icon">💡</div>
      <div class="caption-text">
        <strong>Reproducible research:</strong> Each insight pairs an interactive visualization with a concise narrative and the exact DuckDB SQL query that produced it. Click "Show SQL Query" below any story to view or reproduce the underlying computation.
      </div>
    </div>

    <!-- Stories List -->
    <div class="stories-list">
      {stories.map((story: any, idx: number) => (
        <section class="card story-card" id={story.id}>
          <div class="story-header">
            <span class="story-number">Story {idx + 1}</span>
            <h2>{story.title}</h2>
          </div>

          <p class="story-summary">{story.summary}</p>

          <div class="chart-wrapper">
            <div id={`chart-${story.id}`} class="insight-chart-container" data-story={story.id}>
              <div class="chart-placeholder text-muted">Rendering visualization...</div>
            </div>
          </div>

          <details class="sql-details">
            <summary class="sql-summary">
              <span class="sql-icon">⚙️</span>
              <span>Show DuckDB SQL Query</span>
            </summary>
            <div class="sql-code-block">
              <pre><code>{story.sql}</code></pre>
            </div>
          </details>
        </section>
      ))}
    </div>
  </div>
</Layout>

<style>
  .stories-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .story-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-top: 3px solid var(--accent);
  }

  .story-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .story-number {
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--accent);
  }

  .story-summary {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-primary);
  }

  .chart-wrapper {
    background: var(--bg-subtle);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1rem;
    min-height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-x: auto;
  }

  .insight-chart-container {
    width: 100%;
    min-height: 260px;
  }

  .sql-details {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-subtle);
    overflow: hidden;
  }

  .sql-summary {
    padding: 0.75rem 1rem;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    user-select: none;
    transition: background-color 0.15s ease;
  }

  .sql-summary:hover {
    background-color: var(--bg-hover);
    color: var(--text-primary);
  }

  .sql-code-block {
    padding: 1rem;
    background: #0d1117;
    border-top: 1px solid var(--border-color);
    overflow-x: auto;
  }

  .sql-code-block pre {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #e6edf3;
  }
</style>

<script define:vars={{ stories }}>
  if (stories && stories.length > 0) {
    import('https://cdn.jsdelivr.net/npm/@observablehq/plot@0.6/+esm').then((Plot) => {
      stories.forEach((story) => {
        const container = document.getElementById(`chart-${story.id}`);
        if (!container) return;
        container.innerHTML = '';

        try {
          let plotElement = null;

          if (story.id === 'stars-vs-adoption') {
            const data = story.chart_data;
            plotElement = Plot.plot({
              style: { background: 'transparent', color: 'currentColor' },
              height: 260,
              x: { label: 'Evaluation Horizon (Days)', domain: [30, 60, 90] },
              y: { label: 'Cohort Interaction Retention (%)', grid: true },
              color: { legend: true, domain: ['Breakouts', 'Non-Breakouts'], range: ['#388bfd', '#8b949e'] },
              marks: [
                Plot.line(data, { x: 'horizon_days', y: 'breakouts', stroke: '#388bfd', strokeWidth: 3 }),
                Plot.dot(data, { x: 'horizon_days', y: 'breakouts', fill: '#388bfd', r: 5 }),
                Plot.line(data, { x: 'horizon_days', y: 'non_breakouts', stroke: '#8b949e', strokeWidth: 2, strokeDasharray: '4,4' }),
                Plot.dot(data, { x: 'horizon_days', y: 'non_breakouts', fill: '#8b949e', r: 4 }),
                Plot.ruleY([0]),
              ],
            });
          } else if (story.id === 'ai-era-shift') {
            const data = story.chart_data;
            plotElement = Plot.plot({
              style: { background: 'transparent', color: 'currentColor' },
              height: 260,
              x: { label: 'Year', tickFormat: 'd' },
              y: { label: 'AI/LLM Breakout Share (%)', grid: true },
              marks: [
                Plot.barY(data, { x: 'year', y: 'ai_breakout_pct', fill: '#8957e5' }),
                Plot.text(data, { x: 'year', y: 'ai_breakout_pct', text: (d) => `${d.ai_breakout_pct}%`, dy: -8 }),
                Plot.ruleY([0]),
              ],
            });
          } else if (story.id === 'lead-time') {
            const data = story.chart_data;
            plotElement = Plot.plot({
              style: { background: 'transparent', color: 'currentColor' },
              height: 260,
              x: { label: 'Discovery Lead Time (Days Before Trending)', grid: true },
              y: { label: 'Candidate Count', grid: true },
              marks: [
                Plot.rectY(data, { x: 'lead_days', y: 'count', fill: (d) => (d.lead_days >= 0 ? '#2ea043' : '#d29922') }),
                Plot.ruleX([0], { stroke: '#f85149', strokeWidth: 2 }),
                Plot.text([{ x: 0, y: Math.max(...data.map((d) => d.count)) }], {
                  x: 'x',
                  y: 'y',
                  text: ['Trending Date'],
                  dx: 50,
                  dy: -10,
                  fill: '#f85149',
                }),
              ],
            });
          } else if (story.id === 'suspicion-trends') {
            const data = story.chart_data;
            plotElement = Plot.plot({
              style: { background: 'transparent', color: 'currentColor' },
              height: 260,
              x: { label: 'Year', tickFormat: 'd' },
              y: { label: 'Share with High Suspicion (%)', grid: true },
              color: { legend: true, domain: ['All Candidates', 'Breakout Positives'], range: ['#d29922', '#2ea043'] },
              marks: [
                Plot.line(data, { x: 'year', y: 'high_suspicion_pct', stroke: '#d29922', strokeWidth: 3 }),
                Plot.dot(data, { x: 'year', y: 'high_suspicion_pct', fill: '#d29922', r: 5 }),
                Plot.line(data, { x: 'year', y: 'breakout_high_suspicion_pct', stroke: '#2ea043', strokeWidth: 2 }),
                Plot.dot(data, { x: 'year', y: 'breakout_high_suspicion_pct', fill: '#2ea043', r: 4 }),
                Plot.ruleY([0]),
              ],
            });
          }

          if (plotElement) {
            container.appendChild(plotElement);
          }
        } catch (e) {
          console.error(`Error rendering plot for ${story.id}:`, e);
          container.innerHTML = `<p class="text-muted">Plot visualization could not be loaded in this browser.</p>`;
        }
      });
    });
  }
</script>
