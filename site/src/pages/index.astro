---
import { existsSync } from 'node:fs';
import AppLayout from '../layouts/AppLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import StaleBanner from '../components/layout/StaleBanner.astro';
import RepoRow from '../components/data/RepoRow.astro';
import RailLine from '../components/data/RailLine.astro';
import SegmentedControl from '../components/ui/SegmentedControl.astro';
import Select from '../components/ui/Select.astro';
import Panel from '../components/ui/Panel.astro';
import Pill from '../components/ui/Pill.astro';
import Button from '../components/ui/Button.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import Icon from '../components/ui/Icon.astro';
import ExternalLink from '../components/ui/ExternalLink.astro';
import { getLeaderboard, getMeta, getStatus, getTrackRecord } from '../lib/data';
import { date, delta, pct, plural, shortDate, count } from '../lib/format';
import { url, repoUrl, GITHUB_REPO, HF_SNAPSHOTS } from '../lib/url';

const repos = getLeaderboard();
const meta = getMeta();
const status = getStatus();
const track = getTrackRecord();
const lastSuccess = status.heartbeat?.last_success_at ?? meta.build_time;

const langCounts = new Map<string, number>();
repos.forEach((r) => r.language && langCounts.set(r.language, (langCounts.get(r.language) ?? 0) + 1));
const langs = [...langCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const matured = [...track.matured_snapshots].sort((a, b) => a.snapshot_date.localeCompare(b.snapshot_date));
const lastMatured = matured.at(-1);
const nMatured = track.summary.n_matured_days;
const firstMatureDay = track.ledger.first_date ? new Date(`${track.ledger.first_date}T00:00:00Z`) : null;
if (firstMatureDay) firstMatureDay.setUTCDate(firstMatureDay.getUTCDate() + 30);
const hasFeed = existsSync('public/feed.xml');
---

<AppLayout title={undefined}>
  <PageHeader
    slot="header"
    title="Repos likely to break out"
    lead="Young GitHub repositories most likely to break out in the next 30 days, ranked by breakout chance. Updated every morning from public GitHub activity."
  >
    <Fragment slot="meta">
      <span class="mi"><Icon name="clock" size={14} />Data through {date(meta.data_through)}</span>
      <a class="mi link" href={url('/methodology/#definitions')}><Icon name="info" size={14} />What the numbers mean</a>
    </Fragment>
  </PageHeader>

  <StaleBanner lastSuccess={lastSuccess} dataThrough={meta.data_through} />

  <form id="filters" class="filters" onsubmit="return false" aria-label="Filter the list">
    <SegmentedControl name="show" legend="Show" options={[{ value: 'all', label: 'All' }, { value: 'new', label: 'New today' }]} value="all" />
    <Select name="lang" label="Language" options={[{ value: '', label: 'All languages' }, ...langs.map(([l, n]) => ({ value: l, label: `${l} (${n})` }))]} />
    <Select
      name="sort"
      label="Sort by"
      options={[
        { value: 'chance', label: 'Sort: Chance' },
        { value: 'gain', label: 'Sort: Weekly gain' },
        { value: 'stars', label: 'Sort: Stars' },
        { value: 'newest', label: 'Sort: Newest' },
      ]}
    />
    <label class="check"><input type="checkbox" name="hide" value="unusual" />Hide unusual star patterns</label>
    <span class="count num" id="count" aria-live="polite">{plural(repos.length, 'repo')}</span>
  </form>

  <div class="board">
    <ol id="board" class="list" data-total={repos.length}>
      {repos.map((r, i) => <RepoRow repo={r} eager={i < 6} endDate={meta.data_through} />)}
    </ol>
    <div id="empty" class="empty-wrap" hidden>
      <EmptyState title="No repos match these filters." icon="search">
        <Button slot="action" variant="secondary" size="sm" data-clear>Clear filters</Button>
      </EmptyState>
    </div>
  </div>

  <Fragment slot="rail">
    <Panel title="How to read this list">
      <ul class="how">
        <li><strong>Breakout chance</strong> is the model's estimate that a repo breaks out in the next 30 days.</li>
        <li>The smaller line gives the same number as odds.</li>
        <li>The strip shows stars per day for 28 days, with the last 7 days in color. Each strip uses its own scale, so the shape matters, not the height.</li>
        <li>Star totals come from GitHub. The strip counts stars GH Archive captured, which undercounts since May 2025.</li>
      </ul>
      <a class="more" href={url('/methodology/')}>Read the methodology</a>
    </Panel>

    <Panel title="Track record so far">
      {
        nMatured >= 1 ? (
          <>
            <p class="t-body-sm">
              <strong class="num">{pct(track.summary.top25_hit_rate)}</strong> of top-25 picks broke out, against <strong class="num">{pct(track.summary.base_rate, { digits: 1 })}</strong> for all candidates.
            </p>
            {matured.length >= 3 && <div class="rail-chart"><RailLine values={matured.map((m) => m.precision_at_25)} label="Share of top-25 picks that broke out, by day" /></div>}
            <a class="more" href={url('/track-record/')}>See the track record</a>
          </>
        ) : (
          <>
            <p class="t-body-sm muted">
              No predictions have matured yet. A prediction needs 30 days to be judged{firstMatureDay ? `; the first list matures on ${date(firstMatureDay)}` : ''}.
            </p>
            <a class="more" href={url('/track-record/')}>See the track record</a>
          </>
        )
      }
    </Panel>

    {
      lastMatured && (
        <Panel title="Matured this week">
          <ul class="mat">
            {lastMatured.top25.slice(0, 3).map((p) => (
              <li>
                <a href={repoUrl(p.repo_id)} class="mat-name">{p.repo_name}</a>
                {p.hit ? <Pill variant="rise" icon="check">Hit</Pill> : <Pill>Miss</Pill>}
                <span class="mat-gain num faint">{p.gain_30d != null ? `${delta(p.gain_30d)} stars` : ''}</span>
              </li>
            ))}
          </ul>
          <a class="more" href={url('/track-record/')}>All matured lists</a>
        </Panel>
      )
    }

    <Panel title="Follow the list">
      <ul class="follow">
        {hasFeed && <li><a href={url('/feed.xml')}><Icon name="rss" size={16} />RSS feed</a></li>}
        <li><a href={GITHUB_REPO} target="_blank" rel="noopener"><Icon name="github" size={16} />Source code<Icon name="arrow-up-right" size={12} /></a></li>
        <li><a href={HF_SNAPSHOTS} target="_blank" rel="noopener"><Icon name="database" size={16} />Daily snapshots<Icon name="arrow-up-right" size={12} /></a></li>
      </ul>
    </Panel>
  </Fragment>
</AppLayout>

<script>
  import { plural } from '../lib/format';

  const form = document.getElementById('filters') as HTMLFormElement;
  const board = document.getElementById('board') as HTMLElement;
  const empty = document.getElementById('empty') as HTMLElement;
  const countEl = document.getElementById('count') as HTMLElement;
  const rows = [...board.querySelectorAll<HTMLLIElement>(':scope > li.row')];
  const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement | RadioNodeList;
  const num = (v: string | undefined) => (v === '' || v == null ? null : Number(v));

  const DEFAULTS = { show: 'all', lang: '', sort: 'chance', hide: '' };
  type State = typeof DEFAULTS;
  const KEYS: Record<keyof State, string> = { show: 'new', lang: 'lang', sort: 'sort', hide: 'hide' };

  function fromUrl(): State {
    const p = new URLSearchParams(location.search);
    return {
      show: p.get('new') === '1' ? 'new' : 'all',
      lang: p.get('lang') ?? '',
      sort: ['gain', 'stars', 'newest'].includes(p.get('sort') ?? '') ? p.get('sort')! : 'chance',
      hide: p.get('hide') === 'unusual' ? 'unusual' : '',
    };
  }
  function fromForm(): State {
    return {
      show: (el('show') as RadioNodeList).value || 'all',
      lang: (el('lang') as HTMLSelectElement).value,
      sort: (el('sort') as HTMLSelectElement).value,
      hide: (el('hide') as HTMLInputElement).checked ? 'unusual' : '',
    };
  }
  function toForm(s: State) {
    (el('show') as RadioNodeList).value = s.show;
    const lang = el('lang') as HTMLSelectElement;
    lang.value = [...lang.options].some((o) => o.value === s.lang) ? s.lang : '';
    (el('sort') as HTMLSelectElement).value = s.sort;
    (el('hide') as HTMLInputElement).checked = s.hide === 'unusual';
  }
  function toUrl(s: State) {
    const p = new URLSearchParams();
    if (s.show === 'new') p.set('new', '1');
    if (s.lang) p.set('lang', s.lang);
    if (s.sort !== 'chance') p.set('sort', s.sort);
    if (s.hide) p.set('hide', 'unusual');
    const q = p.toString();
    history.replaceState(null, '', location.pathname + (q ? `?${q}` : '') + location.hash);
  }

  const key = (li: HTMLElement, sort: string): number => {
    const d = li.dataset;
    if (sort === 'gain') return -(num(d.gain) ?? -Infinity);
    if (sort === 'stars') return -(num(d.stars) ?? -Infinity);
    if (sort === 'newest') return num(d.age) ?? Infinity;
    return Number(d.rank);
  };

  function apply(s: State) {
    const sorted = [...rows].sort((a, b) => key(a, s.sort) - key(b, s.sort) || Number(a.dataset.rank) - Number(b.dataset.rank));
    sorted.forEach((li) => board.append(li));
    let shown = 0;
    for (const li of rows) {
      const ok =
        (s.show !== 'new' || li.dataset.new === '1') &&
        (!s.lang || li.dataset.lang === s.lang) &&
        (s.hide !== 'unusual' || li.dataset.unusual !== '1');
      li.hidden = !ok;
      if (ok) shown++;
    }
    empty.hidden = shown > 0;
    board.hidden = shown === 0;
    countEl.textContent = plural(shown, 'repo');
  }

  toForm(fromUrl());
  apply(fromForm());
  form.addEventListener('change', () => {
    const s = fromForm();
    toUrl(s);
    apply(s);
  });
  document.querySelector('[data-clear]')?.addEventListener('click', () => {
    toForm(DEFAULTS);
    toUrl(DEFAULTS);
    apply(DEFAULTS);
  });
  void KEYS;
</script>

<style>
  .mi {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .link:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .filters :global(.sel) {
    min-width: 0;
  }
  .check {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-2);
    cursor: pointer;
  }
  .check input {
    width: 16px;
    height: 16px;
    accent-color: var(--accent);
  }
  .count {
    margin-left: auto;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-3);
  }
  @media (max-width: 639px) {
    .filters {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .filters :global(.seg),
    .check,
    .count {
      grid-column: 1 / -1;
    }
    .filters :global(.seg) {
      display: flex;
    }
    .filters :global(.seg-opt) {
      flex: 1;
    }
    .filters :global(.seg-opt span) {
      flex: 1;
      justify-content: center;
    }
    .count {
      margin-left: 0;
    }
  }
  .list {
    background: var(--raised);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .list :global(.row + .row) {
    border-top: 1px solid var(--line);
  }
  .list :global(.row[hidden] + .row:not([hidden])) {
    border-top: 0;
  }
  .list[hidden],
  .empty-wrap[hidden] {
    display: none;
  }
  .empty-wrap {
    background: var(--raised);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }
  .how {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .how strong {
    color: var(--ink);
    font-weight: 600;
  }
  .more {
    display: inline-block;
    margin-top: 12px;
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
  }
  .more:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .rail-chart {
    margin-top: 12px;
  }
  .mat {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .mat li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px 8px;
    align-items: center;
  }
  .mat-name {
    font-size: 14px;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .mat-gain {
    grid-column: 1 / -1;
    font-size: 12px;
  }
  .follow {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .follow a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 28px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .follow a:hover {
    color: var(--ink);
  }
</style>
