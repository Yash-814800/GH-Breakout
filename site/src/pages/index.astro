---
import Layout from '../layouts/Layout.astro';
import Sparkline from '../components/Sparkline.astro';
import fs from 'node:fs';
import path from 'node:path';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

// Load leaderboard data
let leaderboard = [];
let meta = { data_through: 'Today', model_version: 'champion', counts: { leaderboard: 0 } };

const lbPath = path.resolve('public/data/leaderboard.json');
const metaPath = path.resolve('public/data/meta.json');

if (fs.existsSync(lbPath)) {
  try {
    leaderboard = JSON.parse(fs.readFileSync(lbPath, 'utf-8'));
  } catch (e) {
    console.error('Error reading leaderboard.json', e);
  }
}

if (fs.existsSync(metaPath)) {
  try {
    meta = JSON.parse(fs.readFileSync(metaPath, 'utf-8'));
  } catch (e) {
    console.error('Error reading meta.json', e);
  }
}

// Extract unique languages for filter
const languages = Array.from(new Set(leaderboard.map((r) => r.language).filter(Boolean))).sort();
---

<Layout title="Leaderboard · gh-breakout">
  <div class="container">
    <div class="page-header">
      <div class="header-titles">
        <h1>Breakout Candidate Leaderboard</h1>
        <p class="subtitle">
          Early-stage repositories predicted to gain an unusual number of stars (top 0.5% growth) over the next 30 days.
        </p>
      </div>
      <div class="header-meta">
        <span class="badge badge-accent">Data through: {meta.data_through}</span>
        <span class="badge badge-neutral">Model: {meta.model_version}</span>
      </div>
    </div>

    <div class="caption-banner">
      <div class="caption-icon">ℹ️</div>
      <div class="caption-text">
        <strong>Honest probability:</strong> Each probability is calibrated against historical outcomes. A ~1 in 4 probability means about 25% of candidates with this profile broke out within 30 days. Read our <a href={`${base}/methodology/`}>methodology</a> and inspect verified outcomes on our <a href={`${base}/track-record/`}>live track record</a>.
      </div>
    </div>

    <!-- Filter Controls -->
    <div class="filter-bar">
      <div class="filter-group">
        <label for="search-input" class="filter-label">Search:</label>
        <input type="text" id="search-input" class="form-input" placeholder="Search repository..." />
      </div>

      <div class="filter-group">
        <label for="lang-select" class="filter-label">Language:</label>
        <select id="lang-select" class="form-select">
          <option value="">All languages</option>
          {languages.map((lang) => <option value={lang}>{lang}</option>)}
        </select>
      </div>

      <div class="filter-group">
        <label for="prob-select" class="filter-label">Min Probability:</label>
        <select id="prob-select" class="form-select">
          <option value="0">All</option>
          <option value="0.05">≥ 5% (~1 in 20)</option>
          <option value="0.10">≥ 10% (~1 in 10)</option>
          <option value="0.20">≥ 20% (~1 in 5)</option>
        </select>
      </div>

      <div class="filter-group checkbox-group">
        <label class="checkbox-label">
          <input type="checkbox" id="hide-suspicious" />
          <span>Hide suspicious (Phase 11)</span>
        </label>
      </div>
    </div>

    <!-- Desktop Table View -->
    <div class="table-wrapper desktop-table">
      <table id="leaderboard-table">
        <thead>
          <tr>
            <th style="width: 60px;">Rank</th>
            <th>Repository</th>
            <th>Language</th>
            <th>Age</th>
            <th>Stars (7d / 28d)</th>
            <th>Breakout Prob</th>
            <th>Why Flagged</th>
            <th>On Board</th>
          </tr>
        </thead>
        <tbody>
          {leaderboard.length === 0 ? (
            <tr>
              <td colspan="8" style="text-align: center; padding: 2rem;">
                No candidates available. Run <code>breakout publish site-data</code> to generate data.
              </td>
            </tr>
          ) : (
            leaderboard.map((item) => (
              <tr
                class="repo-row"
                data-name={item.repo_name.toLowerCase()}
                data-lang={item.language || ''}
                data-prob={item.prob}
                data-suspicious={item.suspicion_score ? 'true' : 'false'}
              >
                <td class="num">
                  <div class="rank-badge">
                    <span class="rank-num">{item.rank}</span>
                    {item.rank_change === 'up' && <span class="change-up" title="Moved up">↑</span>}
                    {item.rank_change === 'down' && <span class="change-down" title="Moved down">↓</span>}
                    {item.rank_change === 'new' && <span class="change-new" title="New entry">★</span>}
                    {item.rank_change === 'same' && <span class="change-same" title="Unchanged">•</span>}
                  </div>
                </td>
                <td>
                  <div class="repo-cell">
                    <a href={`${base}/repo/${item.repo_id}/`} class="repo-title">
                      {item.repo_name}
                    </a>
                    {item.description && <div class="repo-desc">{item.description}</div>}
                  </div>
                </td>
                <td>
                  <span class="badge badge-neutral">{item.language || 'Unknown'}</span>
                </td>
                <td class="num">
                  {item.age_days != null ? `${item.age_days} d` : '—'}
                </td>
                <td class="num">
                  <div class="stars-cell">
                    <span class="stars-7d">+{item.stars_7d ?? 0}</span>
                    <Sparkline values={item.spark_stars_28d || []} width={80} height={20} />
                  </div>
                </td>
                <td class="num">
                  <div class="prob-cell">
                    <span class="prob-pct">{(item.prob * 100).toFixed(1)}%</span>
                    <span class="prob-label">{item.prob_label}</span>
                  </div>
                </td>
                <td class="explanation-cell">
                  <span class="explanation-text" title={item.explanation || ''}>
                    {item.explanation || 'Score elevated by recent star velocity.'}
                  </span>
                </td>
                <td class="num text-muted">
                  {item.days_on_board}d
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>

    <!-- Mobile Stacked Cards View -->
    <div class="mobile-cards" id="mobile-cards">
      {leaderboard.map((item) => (
        <div
          class="card mobile-card"
          data-name={item.repo_name.toLowerCase()}
          data-lang={item.language || ''}
          data-prob={item.prob}
          data-suspicious={item.suspicion_score ? 'true' : 'false'}
        >
          <div class="mobile-card-top">
            <span class="badge badge-accent">Rank #{item.rank}</span>
            <span class="prob-pct">{(item.prob * 100).toFixed(1)}% ({item.prob_label})</span>
          </div>
          <a href={`${base}/repo/${item.repo_id}/`} class="repo-title" style="margin: 0.5rem 0;">
            {item.repo_name}
          </a>
          {item.description && <p class="repo-desc">{item.description}</p>}
          <div class="mobile-meta">
            <span class="badge badge-neutral">{item.language || 'Unknown'}</span>
            <span class="num">Age: {item.age_days ?? '—'} d</span>
            <span class="num">7d stars: +{item.stars_7d ?? 0}</span>
          </div>
          {item.explanation && <p class="explanation-text" style="margin-top: 0.5rem;">{item.explanation}</p>}
        </div>
      ))}
    </div>
  </div>
</Layout>

<script>
  // Client-side filtering
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const langSelect = document.getElementById('lang-select') as HTMLSelectElement;
  const probSelect = document.getElementById('prob-select') as HTMLSelectElement;
  const hideSuspicious = document.getElementById('hide-suspicious') as HTMLInputElement;

  function filterItems() {
    const query = searchInput?.value.toLowerCase().trim() || '';
    const lang = langSelect?.value || '';
    const minProb = parseFloat(probSelect?.value || '0');
    const hideSusp = hideSuspicious?.checked || false;

    const rows = document.querySelectorAll('.repo-row');
    const cards = document.querySelectorAll('.mobile-card');

    function checkElem(el: Element) {
      const name = el.getAttribute('data-name') || '';
      const rLang = el.getAttribute('data-lang') || '';
      const prob = parseFloat(el.getAttribute('data-prob') || '0');
      const isSusp = el.getAttribute('data-suspicious') === 'true';

      const matchesQuery = !query || name.includes(query);
      const matchesLang = !lang || rLang === lang;
      const matchesProb = prob >= minProb;
      const matchesSusp = !hideSusp || !isSusp;

      return matchesQuery && matchesLang && matchesProb && matchesSusp;
    }

    rows.forEach((r) => {
      (r as HTMLElement).style.display = checkElem(r) ? '' : 'none';
    });

    cards.forEach((c) => {
      (c as HTMLElement).style.display = checkElem(c) ? '' : 'none';
    });
  }

  searchInput?.addEventListener('input', filterItems);
  langSelect?.addEventListener('change', filterItems);
  probSelect?.addEventListener('change', filterItems);
  hideSuspicious?.addEventListener('change', filterItems);
</script>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .header-meta {
    display: flex;
    gap: 0.5rem;
  }

  .caption-banner {
    display: flex;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
  }

  .caption-icon {
    font-size: 1.25rem;
    line-height: 1;
  }

  .caption-text {
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .checkbox-group {
    margin-left: auto;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    cursor: pointer;
  }

  .rank-badge {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-weight: 700;
  }

  .change-up { color: var(--success); font-weight: bold; }
  .change-down { color: var(--danger); font-weight: bold; }
  .change-new { color: var(--warning); font-size: 0.8rem; }
  .change-same { color: var(--text-muted); font-size: 1.2rem; }

  .repo-cell {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    max-width: 260px;
  }

  .repo-title {
    font-weight: 600;
    color: var(--text-primary);
  }

  .repo-title:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .repo-desc {
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .stars-cell {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stars-7d {
    font-weight: 600;
    color: var(--success);
    min-width: 40px;
  }

  .prob-cell {
    display: flex;
    flex-direction: column;
  }

  .prob-pct {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--accent);
  }

  .prob-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .explanation-cell {
    max-width: 320px;
  }

  .explanation-text {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .mobile-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .mobile-meta {
    display: flex;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
  }
</style>
