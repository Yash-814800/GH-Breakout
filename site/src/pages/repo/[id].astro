---
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const reposDir = path.resolve('public/data/repos');
  if (!fs.existsSync(reposDir)) {
    return [];
  }
  const files = fs.readdirSync(reposDir).filter((f) => f.endsWith('.json'));
  return files.map((f) => {
    const raw = fs.readFileSync(path.join(reposDir, f), 'utf-8');
    const data = JSON.parse(raw);
    const id = f.replace('.json', '');
    return {
      params: { id },
      props: { repo: data },
    };
  });
}

const { repo } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const meta = repo.metadata || {};
const outcome = repo.realized_outcome;
const susp = repo.suspicion_breakdown || null;
const similar = repo.similar_repos || [];
const retention = repo.cohort_retention || null;
---

<Layout title={`${repo.repo_name} · gh-breakout`}>
  <div class="container">
    <div class="breadcrumb">
      <a href={`${base}/`}>← Back to Leaderboard</a>
    </div>

    <!-- Repository Header -->
    <div class="repo-header card">
      <div class="repo-title-row">
        <div>
          <h1>{repo.repo_name}</h1>
          {repo.description && <p class="repo-full-desc">{repo.description}</p>}
        </div>
        <div class="header-actions">
          <a href={repo.html_url} target="_blank" rel="noopener noreferrer" class="btn btn-github">
            <svg height="18" width="18" viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
            View on GitHub
          </a>
        </div>
      </div>

      <!-- Quick Metadata Grid -->
      <div class="meta-pills">
        <span class="badge badge-accent">ID: {repo.repo_id}</span>
        {repo.stars_total != null && <span class="badge badge-neutral" title="Current star count from the GitHub API">★ {repo.stars_total.toLocaleString('en-US')}</span>}
        <span class="badge badge-neutral">Language: {meta.primary_language || 'Unknown'}</span>
        <span class="badge badge-neutral">Owner: {meta.owner_type || 'User'}</span>
        {meta.license_spdx && <span class="badge badge-neutral">License: {meta.license_spdx}</span>}
        {meta.is_fork && <span class="badge badge-warning">Fork</span>}
      </div>

      {meta.topics && meta.topics.length > 0 && (
        <div class="topics-list">
          {meta.topics.map((t: string) => <span class="topic-tag">#{t}</span>)}
        </div>
      )}
    </div>

    <!-- SHAP Explanation & Why Flagged -->
    <div class="grid-2" style="margin-top: 1.5rem;">
      <div class="card">
        <h2>Why Flagged by Model</h2>
        {repo.explanation ? (
          <p class="explanation-box">{repo.explanation}</p>
        ) : (
          <p>Elevated growth pattern identified across star velocity and contributor networks.</p>
        )}

        <h3>Top SHAP Feature Contributions</h3>
        {repo.latest_shap && repo.latest_shap.length > 0 ? (
          <div class="shap-list">
            {repo.latest_shap.map((c: any) => (
              <div class="shap-item">
                <div class="shap-feat">
                  <span class="mono">{c.feature}</span>
                  {c.value != null && <span class="shap-val">val: {c.value}</span>}
                </div>
                <div class="shap-bar-wrapper">
                  <div
                    class={`shap-bar ${c.contribution >= 0 ? 'pos' : 'neg'}`}
                    style={`width: ${Math.min(Math.abs(c.contribution) * 100, 100)}%;`}
                  ></div>
                  <span class="num shap-num">{c.contribution > 0 ? `+${c.contribution.toFixed(3)}` : c.contribution.toFixed(3)}</span>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-muted">Feature contributions available from champion scoring model.</p>
        )}
      </div>

      <!-- Outcome Status & Predictions Timeline -->
      <div class="card">
        <h2>Prediction History & Realized Outcome</h2>
        {outcome ? (
          <div class="outcome-box">
            <div class="outcome-header">
              <span class="stat-label">Realized 30-Day Outcome</span>
              {outcome.hit ? (
                <span class="badge badge-success">✓ Breakout Verified (+{outcome.gain_30d} stars)</span>
              ) : (
                <span class="badge badge-neutral">Did not break out (+{outcome.gain_30d ?? 0} stars)</span>
              )}
            </div>
            <p class="stat-sub">Evaluated as of horizon date {outcome.horizon_date}.</p>
          </div>
        ) : (
          <div class="outcome-box pending">
            <span class="stat-label">Realized 30-Day Outcome</span>
            <span class="badge badge-warning">⏳ Evaluation Pending (30d Horizon Active)</span>
            <p class="stat-sub">Labels mature 30 days after the snapshot date.</p>
          </div>
        )}

        <h3>Flag History</h3>
        <div class="table-wrapper" style="margin-top: 1rem;">
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Rank</th>
                <th>Probability</th>
                <th>Score</th>
                <th>B1 Rank</th>
              </tr>
            </thead>
            <tbody>
              {repo.prediction_history.map((p: any) => (
                <tr>
                  <td class="num">{p.date}</td>
                  <td class="num">#{p.rank}</td>
                  <td class="num">{(p.prob * 100).toFixed(1)}%</td>
                  <td class="num">{p.raw_score ?? '—'}</td>
                  <td class="num">{p.b1_rank ? `#${p.b1_rank}` : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Star History Chart -->
    <div class="card" style="margin-top: 1.5rem;">
      <h2>Star Velocity History</h2>
      <p class="text-muted" style="font-size: 0.8125rem;">Stars captured by GH Archive per day. Capture is partial since mid-2025, so this understates real growth{repo.stars_total != null ? ` (GitHub reports ${repo.stars_total.toLocaleString('en-US')} stars in total)` : ''}.</p>
      <div id="star-chart-container" style="min-height: 200px;">
        {repo.daily_stars && repo.daily_stars.length > 0 ? (
          <div id="star-chart"></div>
        ) : (
          <p class="text-muted">Daily star time-series will display here as daily ingestion accumulates.</p>
        )}
      </div>
    </div>

    <!-- External Appearances: Trending & Hacker News -->
    <div class="grid-2" style="margin-top: 1.5rem;">
      <div class="card">
        <h2>GitHub Trending Appearances</h2>
        {repo.trending_appearances && repo.trending_appearances.length > 0 ? (
          <div class="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Rank</th>
                  <th>Language</th>
                  <th>Source</th>
                </tr>
              </thead>
              <tbody>
                {repo.trending_appearances.map((t: any) => (
                  <tr>
                    <td class="num">{t.date}</td>
                    <td class="num">#{t.rank}</td>
                    <td>{t.language || 'All'}</td>
                    <td><span class="badge badge-neutral">{t.source}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="text-muted">No appearances on GitHub Trending before or on this snapshot date.</p>
        )}
      </div>

      <div class="card">
        <h2>Hacker News Stories</h2>
        {repo.hn_stories && repo.hn_stories.length > 0 ? (
          <div class="hn-list">
            {repo.hn_stories.map((h: any) => (
              <div class="hn-item">
                <a href={h.hn_url} target="_blank" rel="noopener noreferrer" class="hn-title">
                  {h.title}
                </a>
                <div class="hn-meta">
                  <span>{h.points} points</span>
                  <span>{h.num_comments} comments</span>
                  <span class="num">{h.created_at ? h.created_at.split('T')[0] : ''}</span>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-muted">No Hacker News submissions recorded for this repository URL.</p>
        )}
      </div>
    </div>

    <!-- Suspicious-Growth Audit & Integrity (Phase 11, §11.1) -->
    <div class="card" style="margin-top: 1.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
        <h2>Growth Integrity &amp; Star Audit</h2>
        {susp && (
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span class={`badge ${susp.level === 'high' ? 'badge-danger' : susp.level === 'medium' ? 'badge-warning' : 'badge-success'}`}>
              Suspicion Level: {susp.level ? susp.level.toUpperCase() : 'LOW'}
            </span>
            <span class="num text-muted">Score: {susp.score ?? 0}/100</span>
          </div>
        )}
      </div>

      {susp ? (
        <div style="margin-top: 1rem;">
          {susp.reasons && susp.reasons.length > 0 && (
            <div style="background: var(--bg-subtle); padding: 0.75rem 1rem; border-radius: var(--radius-sm); margin-bottom: 1rem; border-left: 3px solid var(--warning);">
              <strong style="font-size: 0.875rem;">Detected Growth Signatures:</strong>
              <ul style="margin: 0.5rem 0 0 1.25rem; font-size: 0.8125rem; color: var(--text-secondary);">
                {susp.reasons.map((r: string) => <li>{r}</li>)}
              </ul>
            </div>
          )}

          <div class="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>Signal Metric</th>
                  <th>Observed Value</th>
                  <th>Typical Candidate Median</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>New Accounts (&lt; 30d old)</td>
                  <td class="num">{susp.signals?.s_new_accounts != null ? `${(susp.signals.s_new_accounts * 100).toFixed(1)}%` : '—'}</td>
                  <td class="num text-muted">{susp.medians?.s_new_accounts != null ? `${(susp.medians.s_new_accounts * 100).toFixed(1)}%` : '~15%'}</td>
                  <td>{susp.signals?.s_new_accounts > 0.4 ? <span class="badge badge-warning">Elevated</span> : <span class="badge badge-neutral">Normal</span>}</td>
                </tr>
                <tr>
                  <td>Inactive Accounts (0 events in 90d)</td>
                  <td class="num">{susp.signals?.s_inactive != null ? `${(susp.signals.s_inactive * 100).toFixed(1)}%` : '—'}</td>
                  <td class="num text-muted">{susp.medians?.s_inactive != null ? `${(susp.medians.s_inactive * 100).toFixed(1)}%` : '~20%'}</td>
                  <td>{susp.signals?.s_inactive > 0.5 ? <span class="badge badge-warning">Elevated</span> : <span class="badge badge-neutral">Normal</span>}</td>
                </tr>
                <tr>
                  <td>Bulk Starrers (50+ stars/day)</td>
                  <td class="num">{susp.signals?.s_bulk != null ? `${(susp.signals.s_bulk * 100).toFixed(1)}%` : '—'}</td>
                  <td class="num text-muted">{susp.medians?.s_bulk != null ? `${(susp.medians.s_bulk * 100).toFixed(1)}%` : '~0%'}</td>
                  <td>{susp.signals?.s_bulk > 0.1 ? <span class="badge badge-warning">Elevated</span> : <span class="badge badge-neutral">Normal</span>}</td>
                </tr>
                <tr>
                  <td>Single-Hour Burst Share</td>
                  <td class="num">{susp.signals?.s_burst != null ? `${(susp.signals.s_burst * 100).toFixed(1)}%` : '—'}</td>
                  <td class="num text-muted">{susp.medians?.s_burst != null ? `${(susp.medians.s_burst * 100).toFixed(1)}%` : '~35%'}</td>
                  <td>{susp.signals?.s_burst > 0.6 ? <span class="badge badge-warning">Elevated</span> : <span class="badge badge-neutral">Normal</span>}</td>
                </tr>
                <tr>
                  <td>Star Velocity without Code Engagement</td>
                  <td class="num">{susp.signals?.s_no_engagement != null ? `${(susp.signals.s_no_engagement * 100).toFixed(1)}%` : '—'}</td>
                  <td class="num text-muted">{susp.medians?.s_no_engagement != null ? `${(susp.medians.s_no_engagement * 100).toFixed(1)}%` : '~50%'}</td>
                  <td>{susp.signals?.s_no_engagement > 0.85 ? <span class="badge badge-warning">Elevated</span> : <span class="badge badge-neutral">Normal</span>}</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 1rem; margin-bottom: 0;">
            <em>Transparency Notice:</em> A high suspicion score reflects statistical divergence from organic candidate baselines (e.g., tight burst timing or account freshness clusters) and is not an accusation of manipulation. Maintainers can request a human audit via our <a href={`${base}/about/`}>review policy</a>.
          </p>
        </div>
      ) : (
        <p class="text-muted" style="margin-top: 0.5rem;">Audit metrics for this repository are within normal organic parameter ranges.</p>
      )}
    </div>

    <!-- Similar Repositories (Phase 11, §11.2) -->
    <div class="card" style="margin-top: 1.5rem;">
      <h2>People Who Starred This Also Starred…</h2>
      <p class="text-muted" style="font-size: 0.8125rem;">
        Top co-starred open-source projects discovered via item-item collaborative filtering (overlap &ge; 5 shared stargazers).
      </p>

      {similar && similar.length > 0 ? (
        <div class="table-wrapper" style="margin-top: 1rem;">
          <table>
            <thead>
              <tr>
                <th>Related Repository</th>
                <th>Language</th>
                <th>Shared Stargazers</th>
                <th>Co-Starring Cosine</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              {similar.map((sim: any) => (
                <tr>
                  <td>
                    <a href={sim.html_url} target="_blank" rel="noopener noreferrer" class="repo-title">
                      {sim.repo_name}
                    </a>
                  </td>
                  <td><span class="badge badge-neutral">{sim.language || 'Unknown'}</span></td>
                  <td class="num">{sim.overlap}</td>
                  <td class="num">{sim.cosine != null ? sim.cosine.toFixed(3) : '—'}</td>
                  <td>
                    <a href={sim.html_url} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-github">
                      View ↗
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="text-muted" style="margin-top: 0.5rem;">
          No sufficiently dense co-starring clusters (overlap &ge; 5) detected in the current reference index.
        </p>
      )}
    </div>

    <!-- Cohort Retention Heatmap (Phase 11, §11.3) -->
    <div class="card" style="margin-top: 1.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
        <h2>Stargazer Cohort Retention &amp; Real Adoption</h2>
        {retention?.reference_comparison && (
          <span class="badge badge-neutral" style="font-size: 0.8125rem;">
            {retention.reference_comparison}
          </span>
        )}
      </div>

      <p class="text-muted" style="font-size: 0.8125rem; margin-top: 0.25rem;">
        Tracks the percentage of weekly stargazers who subsequently engaged in code adoption (forked, opened issues, PRs, or commented) within 30 days of starring.
      </p>

      {retention?.cohorts && retention.cohorts.length > 0 ? (
        <div class="table-wrapper" style="margin-top: 1rem;">
          <table class="cohort-table">
            <thead>
              <tr>
                <th>Cohort Week</th>
                <th>Stargazers</th>
                <th>Forked (30d)</th>
                <th>Issues (30d)</th>
                <th>PRs (30d)</th>
                <th>Comments (30d)</th>
                <th>Any Action (30d)</th>
              </tr>
            </thead>
            <tbody>
              {retention.cohorts.map((c: any) => (
                <tr>
                  <td class="num">{c.cohort_week}</td>
                  <td class="num">★ {c.n_stargazers}</td>
                  <td class="num cohort-cell" style={`background: rgba(46, 160, 67, ${Math.min((c.share_fork_30d || 0) * 8, 0.4)});`}>
                    {c.share_fork_30d != null ? `${(c.share_fork_30d * 100).toFixed(1)}%` : '0.0%'}
                  </td>
                  <td class="num cohort-cell" style={`background: rgba(56, 139, 253, ${Math.min((c.share_issue_30d || 0) * 8, 0.4)});`}>
                    {c.share_issue_30d != null ? `${(c.share_issue_30d * 100).toFixed(1)}%` : '0.0%'}
                  </td>
                  <td class="num cohort-cell" style={`background: rgba(137, 87, 229, ${Math.min((c.share_pull_request_30d || 0) * 8, 0.4)});`}>
                    {c.share_pull_request_30d != null ? `${(c.share_pull_request_30d * 100).toFixed(1)}%` : '0.0%'}
                  </td>
                  <td class="num cohort-cell" style={`background: rgba(210, 153, 34, ${Math.min((c.share_comment_30d || 0) * 8, 0.4)});`}>
                    {c.share_comment_30d != null ? `${(c.share_comment_30d * 100).toFixed(1)}%` : '0.0%'}
                  </td>
                  <td class="num cohort-cell" style={`background: rgba(46, 160, 67, ${Math.min((c.share_any_30d || 0) * 5, 0.5)}); font-weight: 600;`}>
                    {c.share_any_30d != null ? `${(c.share_any_30d * 100).toFixed(1)}%` : '0.0%'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="text-muted" style="margin-top: 0.5rem;">
          Cohort tracking activates once stargazer cohorts have matured through their 30-day follow-up window.
        </p>
      )}
    </div>
  </div>
</Layout>

<script define:vars={{ dailyStars: repo.daily_stars }}>
  // Render Observable Plot if data available
  if (dailyStars && dailyStars.length > 0) {
    import('https://cdn.jsdelivr.net/npm/@observablehq/plot@0.6/+esm').then((Plot) => {
      const container = document.getElementById('star-chart');
      if (container) {
        const data = dailyStars.map((d) => ({
          date: new Date(d.date),
          stars: d.stars,
        }));

        const plot = Plot.plot({
          height: 220,
          marginLeft: 40,
          marginBottom: 30,
          y: { grid: true, label: 'Daily Stars' },
          x: { type: 'time', label: 'Date' },
          marks: [
            Plot.lineY(data, { x: 'date', y: 'stars', stroke: '#4f46e5', strokeWidth: 2 }),
            Plot.dot(data, { x: 'date', y: 'stars', fill: '#4f46e5', r: 3 }),
            Plot.ruleY([0]),
          ],
        });
        container.appendChild(plot);
      }
    }).catch((e) => console.log('Chart loading fallback', e));
  }
</script>

<style>
  .breadcrumb {
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }

  .repo-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .repo-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .repo-full-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-github {
    background: var(--bg-subtle);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }

  .btn-github:hover {
    background: var(--accent-light);
    color: var(--accent);
    text-decoration: none;
  }

  .meta-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .topics-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .topic-tag {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .explanation-box {
    background: var(--bg-subtle);
    padding: 1rem;
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    color: var(--text-primary);
  }

  .shap-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .shap-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .shap-feat {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
  }

  .shap-val {
    color: var(--text-muted);
  }

  .shap-bar-wrapper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 14px;
    background: var(--bg-subtle);
    border-radius: 2px;
  }

  .shap-bar {
    height: 100%;
    border-radius: 2px;
  }

  .shap-bar.pos { background: var(--accent); }
  .shap-bar.neg { background: var(--danger); }
  .shap-num { font-size: 0.75rem; min-width: 45px; }

  .outcome-box {
    background: var(--bg-subtle);
    padding: 1rem;
    border-radius: var(--radius-md);
    margin-bottom: 1rem;
  }

  .outcome-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .hn-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hn-item {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
  }

  .hn-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .hn-title {
    font-weight: 500;
    font-size: 0.875rem;
    color: var(--text-primary);
  }

  .hn-meta {
    display: flex;
