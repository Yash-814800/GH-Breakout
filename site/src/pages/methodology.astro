---
import LongformLayout from '../layouts/LongformLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import Table from '../components/ui/Table.astro';
import Pill from '../components/ui/Pill.astro';
import ExternalLink from '../components/ui/ExternalLink.astro';
import { getMeta } from '../lib/data';
import { modelRows } from '../lib/model-metrics';
import sharp from 'sharp';
import { url, HF_MODELS, GITHUB_REPO } from '../lib/url';

const meta = getMeta();
const rows = modelRows();
const f3 = (n: number) => n.toFixed(3);
const f4 = (n: number) => n.toFixed(4);
const toc = [
  { id: 'definitions', label: 'Definitions' },
  { id: 'evaluation', label: 'How we test' },
  { id: 'calibration', label: 'Calibration' },
  { id: 'features', label: 'What the model sees' },
  { id: 'limits', label: 'Known limits' },
];
const fig = (name: string) => url(`/figures/${name}`);
// Real pixel sizes, so each image reserves its space before it loads (no layout shift).
const size: Record<string, { w: number; h: number }> = {};
for (const n of ['cv_pr_curve', 'cv_precision_by_year', 'cv_reliability', 'shap_importance', 'shap_beeswarm']) {
  const m = await sharp(`public/figures/${n}.png`).metadata();
  size[n] = { w: m.width ?? 900, h: m.height ?? 600 };
}
---

<LongformLayout title="Methodology" description="How Breakout Radar defines a breakout, picks candidates, tests the model against simple baselines and checks its probabilities." toc={toc}>
  <PageHeader slot="header" size="display" title="Methodology" lead="What a breakout is, how candidates are chosen, and how we check the model against simple rules.">
    <Fragment slot="meta"><Pill variant="accent">Model {meta.model_version}</Pill><ExternalLink href={HF_MODELS}>Model card</ExternalLink></Fragment>
  </PageHeader>

  <div class="prose measure">
    <h2 id="definitions">Definitions</h2>
    <p>
      A <strong>breakout</strong> is a repo gaining stars faster than 99.5% of similar young repos over the next 30 days, and at least 100 stars. The
      <strong>breakout chance</strong> on each repo is the model's calibrated probability of that outcome.
    </p>
    <dl class="defs">
      <dt>Candidate</dt>
      <dd>A repo that is at most 90 days old, has fewer than 200 stars before the snapshot date, gained at least 5 stars in the 14 days before it, and is not a fork, mirror or bot-owned.</dd>
      <dt>Snapshot date</dt>
      <dd>The world as known at 00:00 UTC on that day. Features use only events before it.</dd>
      <dt>Label</dt>
      <dd>Stars gained from the snapshot date to 30 days later, compared with other candidates of the same day. A second label counts 500 or more stars.</dd>
      <dt>Matured</dt>
      <dd>A prediction is judged only after its 30 days have fully passed and been ingested.</dd>
      <dt>Flagged</dt>
      <dd>Entered the top 50 of a daily list.</dd>
    </dl>
    <p class="note">The strip on each repo scales to that repo's own peak, so the shape of the curve is the signal, not the height.</p>
  </div>

  <div class="measure">
    <div class="prose">
      <h2 id="evaluation">How we test</h2>
      <p>
        We test the model on weeks it never saw. Training uses data up to a cut-off, a 30-day gap follows so no label overlaps training, and the test weeks come after. This repeats over 29 steps from 2018 to 2025. Random splits are never used, because they would let the model see the future.
      </p>
      <p>Every model has to beat a simple baseline that ranks repos by stars gained in the last 7 days, on both PR-AUC and precision at 25, before it is used.</p>
    </div>
  </div>

  {
    rows && (
      <div class="wide fig">
        <Table caption="Pooled results over 29 test periods, 2018 to 2025 (95% confidence interval in brackets)" stickyFirst>
          <thead><tr><th>Model</th><th class="r">PR-AUC</th><th class="r">ROC-AUC</th><th class="r">Precision at 25</th></tr></thead>
          <tbody>
            {
              rows.map((r) => (
                <tr>
                  <td>{r.key === 'model' ? <strong>{r.name}</strong> : r.name}</td>
                  <td class="r">{f4(r.prAuc)} <span class="ci">[{f4(r.prCi[0])}, {f4(r.prCi[1])}]</span></td>
                  <td class="r">{f3(r.roc)}</td>
                  <td class="r">{r.p25 != null ? f3(r.p25) : '—'} {r.p25Ci && <span class="ci">[{f3(r.p25Ci[0])}, {f3(r.p25Ci[1])}]</span>}</td>
                </tr>
              ))
            }
          </tbody>
        </Table>
      </div>
    )
  }

  <div class="wide figs">
    <figure><img src={fig('cv_pr_curve.png')} alt="Precision-recall curve of the model and baselines over all test periods" width={size.cv_pr_curve!.w} height={size.cv_pr_curve!.h} loading="lazy" /><figcaption>Precision against recall, all test periods.</figcaption></figure>
    <figure><img src={fig('cv_precision_by_year.png')} alt="Precision at 25 per year for the model and the baseline" width={size.cv_precision_by_year!.w} height={size.cv_precision_by_year!.h} loading="lazy" /><figcaption>Precision at 25 for each year.</figcaption></figure>
  </div>

  <div class="measure">
    <div class="prose">
      <h2 id="calibration">Calibration</h2>
      <p>
        A model can rank well and still give misleading percentages. Only about 1 in 200 candidates breaks out, so raw scores do not read as odds. We map them to probabilities with isotonic regression fitted on weeks the model did not train on. Across all test periods the calibration error is 0.0002 and the Brier score 0.0047.
      </p>
      <p>If 100 repos get a 20% chance, about 20 of them should break out. The live <a href={url('/track-record/')}>track record</a> checks this on real predictions as they mature.</p>
    </div>
  </div>
  <div class="wide figs one">
    <figure><img src={fig('cv_reliability.png')} alt="Reliability diagram: predicted chance against the share that broke out" width={size.cv_reliability!.w} height={size.cv_reliability!.h} loading="lazy" /><figcaption>Reliability diagram for the test periods.</figcaption></figure>
  </div>

  <div class="measure">
    <div class="prose">
      <h2 id="features">What the model sees</h2>
      <p>
        68 signals available every day: star growth, who is starring and how experienced their accounts are, contributor activity, issue response times, and Hacker News mentions. Each signal uses only data from before the snapshot date. The explanation on each repo comes from SHAP values, which say how much each signal moved that repo's chance up or down.
      </p>
    </div>
  </div>
  <div class="wide figs">
    <figure><img src={fig('shap_importance.png')} alt="Average impact of the most important features on the model output" width={size.shap_importance!.w} height={size.shap_importance!.h} loading="lazy" /><figcaption>Average impact of the top features.</figcaption></figure>
    <figure><img src={fig('shap_beeswarm.png')} alt="Distribution of feature impacts across repos" width={size.shap_beeswarm!.w} height={size.shap_beeswarm!.h} loading="lazy" /><figcaption>How high and low feature values push the chance.</figcaption></figure>
  </div>

  <div class="measure">
    <div class="prose">
      <h2 id="limits">Known limits</h2>
      <ul>
        <li><strong>Attention outside GitHub.</strong> Posts on X, Reddit or YouTube are invisible to the model until the stars start to arrive.</li>
        <li><strong>GH Archive star capture dropped in May 2025.</strong> From May 24, 2025, GH Archive records far fewer stars. Training stops at May 23, 2025, and star totals on the site come from GitHub directly. The momentum strip still shows only the stars GH Archive captured.</li>
        <li><strong>GitHub trimmed event data on October 7, 2025.</strong> Pull request authors and commit lists were removed from public events. The live model uses only signals that survive this change.</li>
        <li><strong>Star manipulation.</strong> A neutral "Unusual star pattern" label marks repos whose recent stars look different from other young repos. It is a statistical signal, not an accusation, and it never changes the model's score.</li>
        <li><strong>Back-tests are simulations.</strong> The back-test uses out-of-sample predictions, not lists published at the time. Only the <a href={url('/track-record/')}>track record</a> counts as live.</li>
      </ul>
      <p>Code, data and the full model card are public on <a href={GITHUB_REPO}>GitHub</a> and Hugging Face.</p>
    </div>
  </div>
</LongformLayout>

<style>
  .measure + .measure,
  .fig,
  .figs {
    margin-top: 24px;
  }
  .fig .ci {
    color: var(--ink-3);
    font-size: 12px;
    white-space: nowrap;
  }
  .figs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  @media (min-width: 768px) {
    .figs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .figs.one {
      grid-template-columns: minmax(0, 520px);
      justify-content: center;
    }
  }
  .figs figure {
    margin: 0;
    padding: 12px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
  }
  .figs img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--r-lg);
  }
  .figs figcaption {
    margin-top: 8px;
    font-size: 13px;
    color: var(--ink-3);
  }
  :global(.prose.measure .note),
  .note {
    font-size: 14px;
    color: var(--ink-2);
  }
</style>
