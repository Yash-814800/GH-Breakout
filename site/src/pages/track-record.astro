---
import LongformLayout from '../layouts/LongformLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import Section from '../components/layout/Section.astro';
import FactStrip from '../components/data/FactStrip.astro';
import ChartFigure from '../components/data/ChartFigure.astro';
import MaturedList from '../components/data/MaturedList.astro';
import Callout from '../components/ui/Callout.astro';
import Panel from '../components/ui/Panel.astro';
import CopyButton from '../components/ui/CopyButton.astro';
import ExternalLink from '../components/ui/ExternalLink.astro';
import Pill from '../components/ui/Pill.astro';
import { getTrackRecord } from '../lib/data';
import { date, hash, pct, pctAxis, plural } from '../lib/format';
import { GITHUB_REPO, HF_SNAPSHOTS } from '../lib/url';

const t = getTrackRecord();
const s = t.summary;
const headline = (s as Record<string, unknown>).headline as string | undefined;
const n = s.n_matured_days;
const matured = [...t.matured_snapshots].sort((a, b) => a.snapshot_date.localeCompare(b.snapshot_date));
const calibration = t.calibration.filter((c) => c.count > 0);
const lead = n < 1 ? 'Every list is frozen the day it is published, then judged 30 days later.' : headline ?? '';
const cells = [
  { label: 'Top-25 hit rate', value: n > 0 ? pct(s.top25_hit_rate) : '—', xl: true, hint: n > 0 ? 'Share of our top-25 picks that broke out within 30 days.' : 'Shown once the first list has matured.' },
  { label: 'Baseline hit rate', value: pct(s.b1_hit_rate), xl: true, hint: 'The same measure for a simple rule: rank by stars gained in the last 7 days.' },
  { label: 'Median lead over GitHub Trending', value: s.median_lead_time_days != null ? plural(Math.round(s.median_lead_time_days), 'day') : '—', xl: true, hint: 'How much earlier than Trending we flagged repos that later trended (back-test).' },
];
const chartData = { points: matured.map((m) => ({ date: m.snapshot_date, p25: m.precision_at_25, b1: m.b1_precision_at_25 ?? null })), calibration };
---

<LongformLayout title="Track record" description={n < 1 ? 'Every daily list is frozen when published and judged 30 days later. No predictions have matured yet.' : (headline ?? '').slice(0, 155)} wide>
  <PageHeader slot="header" size="display" center title="Track record" lead={lead}>
    <Fragment slot="meta">
      {t.ledger.verified && <Pill variant="rise" icon="shield-check">Ledger verified</Pill>}
      <span>{plural(s.n_live_days, 'list')} published, {plural(n, 'list')} judged</span>
    </Fragment>
  </PageHeader>

  <FactStrip cells={cells} />

  {
    n < 30 && (
      <Section>
        <Callout variant="info">History is short: {n} matured {n === 1 ? 'day' : 'days'} so far. Charts appear once 30 days have matured, so a few lucky days cannot look like a trend.</Callout>
      </Section>
    )
  }

  {
    n >= 30 && (
      <Section id="precision" title="Hit rate over time">
        <ChartFigure id="chart-p25" title="Share of top-25 picks that broke out" summary={`Daily top-25 hit rate over ${n} matured days, compared with the baseline.`} legend={[{ label: 'Our top 25', kind: 'line', color: 'accent' }, { label: 'Baseline: 7-day star velocity', kind: 'dash', color: 'ink-3' }]} />
      </Section>
    )
  }

  {
    n >= 30 && calibration.length > 0 && (
      <Section id="calibration" title="Do the percentages mean what they say?">
        <p class="t-body-sm muted measure lead-in">Repos are grouped by the chance we gave them. If the dots sit on the diagonal, that share really broke out.</p>
        <ChartFigure id="chart-cal" title="Predicted chance against what happened" level="h3" height={380} summary="Reliability diagram: predicted chance on the x axis, share that broke out on the y axis." />
      </Section>
    )
  }

  {
    matured.length > 0 && (
      <Section id="matured" title="Matured predictions">
        <MaturedList days={matured} />
      </Section>
    )
  }

  <Section id="verify" title="Verify this record">
    <Panel>
      <ol class="steps">
        <li>
          <span class="step-n">1</span>
          <div>
            <p><strong>Every list is hashed into a public chain.</strong> Each row of the ledger contains the hash of the row before it, so an edit to the past breaks every later hash.</p>
            <div class="hash">
              <span class="t-caption faint">Latest hash</span>
              <code title={t.ledger.last_hash}>{hash(t.ledger.last_hash)}</code>
              <CopyButton text={t.ledger.last_hash} label="Copy hash" />
            </div>
          </div>
        </li>
        <li>
          <span class="step-n">2</span>
          <div><p><strong>Check the chain yourself.</strong> Clone the repository and run <code>uv run breakout ops verify-ledger</code>. It recomputes every hash.</p></div>
        </li>
        <li>
          <span class="step-n">3</span>
          <div>
            <p><strong>Compare with the raw files.</strong> The daily prediction files are on Hugging Face and the ledger is a CSV in the repository.</p>
            <p class="links"><ExternalLink href={HF_SNAPSHOTS}>Snapshots dataset</ExternalLink> <ExternalLink href={`${GITHUB_REPO}/blob/main/ledger/predictions.csv`}>ledger/predictions.csv</ExternalLink></p>
          </div>
        </li>
      </ol>
      <p class="t-caption faint ledger">
        {plural(t.ledger.total_rows, 'ledger row')}{t.ledger.first_date ? `, from ${date(t.ledger.first_date)}` : ''}{t.ledger.last_date ? ` to ${date(t.ledger.last_date)}` : ''}.
      </p>
    </Panel>
  </Section>

  <script type="application/json" id="tr-data" set:html={JSON.stringify(chartData)} />
</LongformLayout>

<script>
  import * as Plot from '@observablehq/plot';
  import { baseOptions, observeWidth, resolveTokens } from '../lib/plot-theme';
  import { date, pct, pctAxis, shortDate } from '../lib/format';

  const data = JSON.parse(document.getElementById('tr-data')!.textContent!) as {
    points: { date: string; p25: number; b1: number | null }[];
    calibration: { bin_start: number; bin_end: number; predicted_avg: number; realized_avg: number; count: number }[];
  };
  const day = (s: string) => new Date(`${s}T00:00:00Z`);

  const p = document.getElementById('chart-p25');
  if (p) {
    observeWidth(p, (w) => {
      const t = resolveTokens();
      const o = baseOptions(t, w);
      const ours = data.points.map((d) => ({ x: day(d.date), y: d.p25 }));
      const base = data.points.filter((d) => d.b1 != null).map((d) => ({ x: day(d.date), y: d.b1! }));
      p.replaceChildren(
        Plot.plot({
          ...o,
          x: { ...o.x, type: 'utc', tickFormat: (d: Date) => shortDate(d) },
          y: { ...o.y, tickFormat: (v: number) => pctAxis(v), zero: true, nice: true },
          marks: [
            Plot.lineY(base, { x: 'x', y: 'y', stroke: t.ink3, strokeWidth: 2, strokeDasharray: '4 4' }),
            Plot.lineY(ours, { x: 'x', y: 'y', stroke: t.accent, strokeWidth: 2 }),
            Plot.tip(ours, Plot.pointerX({ x: 'x', y: 'y', fill: t.raised, stroke: t.line, format: { x: (d: Date) => date(d), y: (v: number) => pct(v) } })),
          ],
        }),
      );
    });
  }

  const c = document.getElementById('chart-cal');
  if (c) {
    observeWidth(c, (w) => {
      const t = resolveTokens();
      const size = Math.min(420, w);
      const o = baseOptions(t, size, size);
      c.replaceChildren(
        Plot.plot({
          ...o,
          marginBottom: 44,
          marginLeft: 64,
          x: { ...o.x, domain: [0, 1], tickFormat: (v: number) => pctAxis(v), label: 'Predicted chance', labelAnchor: 'center' },
          y: { ...o.y, domain: [0, 1], tickFormat: (v: number) => pctAxis(v), label: 'Share that broke out', labelAnchor: 'center' },
          marks: [
            Plot.line([[0, 0], [1, 1]], { stroke: t.lineStrong, strokeDasharray: '4 4' }),
            Plot.dot(data.calibration, { x: 'predicted_avg', y: 'realized_avg', r: (d: { count: number }) => 3 + Math.sqrt(d.count), fill: t.accent, fillOpacity: 0.8 }),
          ],
        }),
      );
    });
  }
</script>

<style>
  .lead-in {
    margin-bottom: 12px;
  }
  .steps {
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: 15px;
    line-height: 1.5;
  }
  .steps li {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 12px;
  }
  .step-n {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: var(--r-pill);
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 13px;
    font-weight: 600;
  }
  .hash {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }
  .hash code {
    padding: 2px 6px;
    background: var(--bg);
    border-radius: var(--r-xs);
    font-size: 13px;
  }
  .steps code {
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin-top: 6px;
  }
  .ledger {
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
</style>
