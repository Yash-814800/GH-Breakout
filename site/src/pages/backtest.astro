---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

let backtest = {
  historical_dates: [],
  date_summaries: [],
  is_simulated_disclaimer: 'Simulated, out-of-fold historical backtest predictions. Not live predictions.',
};

const btPath = path.resolve('public/data/backtest.json');
if (fs.existsSync(btPath)) {
  try {
    backtest = JSON.parse(fs.readFileSync(btPath, 'utf-8'));
  } catch (e) {
    console.error('Error reading backtest.json', e);
  }
}

const dates = backtest.historical_dates || [];
const defaultDate = dates.length > 0 ? dates[dates.length - 1] : '';
---

<Layout title="Backtest Time Machine · gh-breakout">
  <div class="container">
    <div class="page-header">
      <div>
        <h1>Historical Backtest Time Machine</h1>
        <p class="subtitle">
          Inspect how the machine learning model would have scored candidates on any historical snapshot date from 2018 to 2025.
        </p>
      </div>
    </div>

    <!-- Mandatory Disclaimer Banner -->
    <div class="card warning-banner">
      <div class="banner-content">
        <span class="warning-icon">⚠️</span>
        <div>
          <strong>Out-of-Fold Simulation Notice:</strong> {backtest.is_simulated_disclaimer}
          All evaluations shown on this page were produced during rolling-origin cross-validation with a strict 30-day horizon embargo. No future data was accessible to the model at scoring time.
        </div>
      </div>
    </div>

    <!-- Date Selector -->
    <div class="card" style="margin-bottom: 2rem;">
      <div class="selector-row">
        <div>
          <label for="date-select" style="font-weight: 600; display: block; margin-bottom: 0.5rem;">
            Select Historical Snapshot Date:
          </label>
          <select id="date-select" class="form-select" style="min-width: 260px; font-size: 1rem;">
            {dates.map((d: string) => (
              <option value={d} selected={d === defaultDate}>
                {d}
              </option>
            ))}
          </select>
        </div>
        <div id="date-stats" class="date-summary-box">
          <span class="stat-label">Snapshot Summary</span>
          <div class="stat-meta">
            <span id="stat-p25" class="badge badge-accent">Precision @ 25: Loading...</span>
            <span id="stat-count" class="badge badge-neutral">Top 100 available in SQL Explorer</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Backtest Top 25 Table Container -->
    <div class="card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h2>Top 25 Candidates on <span id="current-date-title">{defaultDate}</span></h2>
        <a href={`${base}/explore/`} class="btn btn-outline" style="font-size: 0.8125rem;">
          Query all in SQL Explorer →
        </a>
      </div>

      <div class="table-wrapper">
        <table id="backtest-table">
          <thead>
            <tr>
              <th style="width: 60px;">Rank</th>
              <th>Repository</th>
              <th>Breakout Probability</th>
              <th>Raw Score</th>
              <th>Realized 30d Gain</th>
              <th>Outcome (Top 0.5%)</th>
            </tr>
          </thead>
          <tbody id="backtest-tbody">
            <tr>
              <td colspan="6" style="text-align: center; padding: 2rem;">
                Loading snapshot predictions...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ base, dates, dateSummaries: backtest.date_summaries }}>
  const dateSelect = document.getElementById('date-select');
  const tbody = document.getElementById('backtest-tbody');
  const dateTitle = document.getElementById('current-date-title');
  const statP25 = document.getElementById('stat-p25');

  const summariesByDate = {};
  if (dateSummaries) {
    dateSummaries.forEach((s) => {
      summariesByDate[s.snapshot_date] = s;
    });
  }

  // Use DuckDB-WASM or pre-canned fetch over oof_top100.parquet
  async function loadSnapshot(selectedDate) {
    if (!selectedDate) return;
    if (dateTitle) dateTitle.textContent = selectedDate;

    const s = summariesByDate[selectedDate];
    if (s && statP25) {
      statP25.textContent = `P@25: ${(s.precision_at_25 * 100).toFixed(1)}%`;
    }

    if (tbody) {
      tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 2rem;">Loading snapshot data from Parquet...</td></tr>';
    }

    try {
      // Lazy load DuckDB-WASM to query the exact rows
      const duckdb = await import('https://cdn.jsdelivr.net/npm/@duckdb/duckdb-wasm@1.29.0/+esm');
      const JSDELIVR_BUNDLES = duckdb.getJsDelivrBundles();
      const bundle = await duckdb.selectBundle(JSDELIVR_BUNDLES);
      const worker_url = URL.createObjectURL(
        new Blob([`importScripts("${bundle.mainWorker}");`], { type: 'text/javascript' })
      );
      const worker = new Worker(worker_url);
      const logger = new duckdb.VoidLogger();
      const db = new duckdb.AsyncDuckDB(logger, worker);
      await db.instantiate(bundle.mainModule, bundle.pthreadWorker);
      URL.revokeObjectURL(worker_url);

      const conn = await db.connect();
      const parquetUrl = `${base}/data/explorer/oof_top100.parquet`;
      await conn.query(`CREATE VIEW IF NOT EXISTS oof AS SELECT * FROM read_parquet('${parquetUrl}');`);

      const result = await conn.query(`
        SELECT rank, repo_id, repo_name, prob, raw_score, gain_30d, label
        FROM oof
        WHERE snapshot_date = '${selectedDate}'
        ORDER BY rank ASC
        LIMIT 25;
      `);

      const rows = result.toArray();
      if (rows.length === 0) {
        if (tbody) {
          tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 2rem;">No candidates returned for this snapshot date.</td></tr>';
        }
        return;
      }

      let html = '';
      rows.forEach((r) => {
        const isHit = r.label === true;
        const gain = r.gain_30d != null ? `+${Math.round(r.gain_30d)}` : '—';
        html += `
          <tr>
            <td class="num"><strong>#${r.rank}</strong></td>
            <td><strong>${r.repo_name}</strong></td>
            <td class="num">${(r.prob * 100).toFixed(1)}%</td>
            <td class="num">${r.raw_score.toFixed(3)}</td>
            <td class="num">${gain} stars</td>
            <td>
              <span class="badge ${isHit ? 'badge-success' : 'badge-neutral'}">
                ${isHit ? '✓ Breakout' : '✗ Not Hit'}
              </span>
            </td>
          </tr>
        `;
      });

      if (tbody) tbody.innerHTML = html;
      await conn.close();
    } catch (err) {
      console.warn('WASM execution fallback:', err);
      if (tbody) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; padding: 1.5rem;">Snapshot data available in the <a href="${base}/explore/">SQL Explorer</a>.</td></tr>`;
      }
    }
  }

  dateSelect?.addEventListener('change', (e) => {
    loadSnapshot(e.target.value);
  });

  if (dateSelect?.value) {
    loadSnapshot(dateSelect.value);
  }
</script>

<style>
  .warning-banner {
    border-left: 4px solid var(--warning);
    background: var(--warning-bg);
    margin-bottom: 2rem;
  }

  .banner-content {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .warning-icon {
    font-size: 1.5rem;
    line-height: 1;
  }

  .selector-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .date-summary-box {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-meta {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .btn-outline {
    border: 1px solid var(--border-color);
    background: var(--bg-card);
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
  }

  .btn-outline:hover {
    background: var(--bg-subtle);
    color: var(--accent);
    text-decoration: none;
  }
</style>
